{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": "src",
		"outDir": "dist",
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"sourceMap": true,
		"declarationMap": true,
		"types": ["node"],
		"verbatimModuleSyntax": true
	},
	"include": ["src/**/*.ts"]
}
